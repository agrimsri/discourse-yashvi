{
  "manifest_version": 3,
  "name": "Discourse Smart Reply Assistant (for Yashvi)",
  "version": "1.0.0",
  "description": "Finds similar past answers on IITM Discourse and allows 1-click copying or inserting into the reply composer.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://discourse.onlinedegree.iitm.ac.in/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Discourse Reply Assistant",
    "default_icon": "icon128.png"
  },
  "icons": {
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://discourse.onlinedegree.iitm.ac.in/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
